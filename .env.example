# Токен от @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# AITunnel API (https://aitunnel.ru) — ключ sk-aitunnel-... из раздела «API ключи»
# Зеркало при блокировке хоста: https://ru-api.aitunnel.ru/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.aitunnel.ru/v1
# gpt-4o-mini: текст + картинки. Дешевле: deepseek-chat (без vision)
LLM_MODEL=gpt-4o-mini
# Генерация фото товара для инфографики
IMAGE_MODEL=gpt-image-1-mini

# Billing (SQLite + UnitPay callback)
# BILLING_DB_PATH=data/billing.sqlite3
# На VPS за nginx лучше 127.0.0.1; локально можно 0.0.0.0
BILLING_HTTP_HOST=127.0.0.1
BILLING_HTTP_PORT=8088
# Публичный HTTPS URL до бота на VPS, без слэша в конце.
# В кабинете UnitPay: {BILLING_PUBLIC_BASE_URL}/billing/unitpay
# См. docs/deploy-regru.md
BILLING_PUBLIC_BASE_URL=https://YOUR_DOMAIN

# UnitPay (RU / RUB) — ключи после одобрения проекта
UNITPAY_PROJECT_ID=
UNITPAY_PUBLIC_KEY=
UNITPAY_SECRET_KEY=
# НДС в чеке: для ИП на НПД обычно none
UNITPAY_RECEIPT_NDS=none
# UNITPAY_SKIP_IP_CHECK=1

# Telegram user ids через запятую — тест /grant credits N | /grant pro DAYS
# BILLING_ADMIN_IDS=

# 0 = дневные лимиты включены (1 карточка / 5 вопросов / 1 создание; правки Word — кредиты)
# 1 = тестовый режим без блокировок
BILLING_OPEN_ACCESS=0

# Партнёрские ссылки гида «ИП на НПД» (кнопки в боте)
# Альфа: заявка по вашей партнёрской ссылке; клиент должен сказать «ИП на НПД»
ALFA_IP_NPD_URL=https://alfa.me/AK1Rlb
# Точка: расчётный счёт / эквайринг (подставьте свою рефералку, если есть)
TOCHKA_RKO_URL=https://tochka.com/
# MY_NALOG_URL=https://npd.nalog.ru/
# FNS_IP_REG_URL=https://service.nalog.ru/gosreg/index.html
